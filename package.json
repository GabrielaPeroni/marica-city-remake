{
  "name": "marica-city",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend tooling (CSS build, JS lint/build) for MaricaCity static assets.",
  "scripts": {
    "build:css": "node scripts/build-css.mjs",
    "watch:css": "tailwindcss --input frontend/css/app.css --output static/css/app.css --watch",
    "lint:js": "eslint static/js",
    "build:js": "node scripts/build-js.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/cli": "4.3.3",
    "basecoat-css": "1.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "lucide-static": "1.58.0",
    "tailwindcss": "4.3.3"
  }
}
