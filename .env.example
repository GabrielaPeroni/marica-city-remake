# Copy this file to .env and fill in real values for your environment.
# Django will read these via python-decouple's config() calls in config/settings/*.py.

# Settings module (default: config.settings.dev; production should set config.settings.prod)
# DJANGO_SETTINGS_MODULE=config.settings.dev

# Django secret key used for cryptographic signing (required, no default — generate a unique value)
SECRET_KEY=change-me-to-a-random-secret-key

# Enable Django debug mode (default: False)
DEBUG=True

# Comma-separated list of allowed hostnames (default: localhost,127.0.0.1)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database backend engine (default: django.db.backends.sqlite3)
DB_ENGINE=django.db.backends.sqlite3

# Database name / path (default: BASE_DIR/db.sqlite3 for sqlite3)
DB_NAME=db.sqlite3

# Database user (default: empty, unused for sqlite3)
DB_USER=

# Database password (default: empty, unused for sqlite3)
DB_PASSWORD=

# Database host (default: empty, unused for sqlite3)
DB_HOST=

# Database port (default: empty, unused for sqlite3)
DB_PORT=

# Google OAuth client ID used for "Sign in with Google" (required, no default)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Google Maps API key, used for map embeds (default: empty/optional)
GOOGLE_MAPS_API_KEY=

# Enable django-ratelimit protections (default: True)
RATELIMIT_ENABLE=True

# Redis URL for cache/rate-limiting; empty uses LocMemCache (dev-only, not multi-process safe)
CACHE_URL=
# Fallback if CACHE_URL is unset (some PaaS providers inject this automatically)
REDIS_URL=

# --- Production-only settings (config.settings.prod), each secure by default ---

# Redirect all non-HTTPS requests to HTTPS (default: True in prod)
SECURE_SSL_REDIRECT=True

# Only send the session cookie over HTTPS (default: True in prod)
SESSION_COOKIE_SECURE=True

# Only send the CSRF cookie over HTTPS (default: True in prod)
CSRF_COOKIE_SECURE=True

# HSTS max-age in seconds (default: 86400 = 1 day; raise once HTTPS is confirmed stable)
SECURE_HSTS_SECONDS=86400

# Apply HSTS to all subdomains too (default: True in prod)
SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# Allow this domain in browsers' HSTS preload lists (default: True in prod; hard to reverse quickly)
SECURE_HSTS_PRELOAD=True

# Send X-Content-Type-Options: nosniff on all responses (default: True in prod)
SECURE_CONTENT_TYPE_NOSNIFF=True

# Media storage on Cloudflare R2 (S3-compatible), used only when AWS_STORAGE_BUCKET_NAME is set.
# Leave all empty in dev to keep using local MEDIA_ROOT.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
# R2 endpoint, e.g. https://<account_id>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=
# R2 has no regions; "auto" works (default: auto)
AWS_S3_REGION_NAME=auto
# Optional public/custom domain (R2 public bucket or CDN) serving MEDIA_URL instead of the endpoint
AWS_S3_CUSTOM_DOMAIN=
